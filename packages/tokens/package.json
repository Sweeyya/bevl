{
  "name": "@toros/tokens",
  "version": "0.1.0",
  "description": "Reads design systems. Turns tokens into 3D materials and lights.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "knowledge",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sweeyya/toros.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Sweeyya/toros#readme",
  "bugs": {
    "url": "https://github.com/Sweeyya/toros/issues"
  }
}
