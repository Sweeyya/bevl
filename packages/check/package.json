{
  "name": "@toros/check",
  "version": "0.1.0",
  "description": "The checker. Runs the site in a browser, tests every design rule and budget, and writes a scored report.",
  "type": "module",
  "bin": {
    "toros-check": "./dist/bin/check.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "pngjs": "7.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sweeyya/toros.git",
    "directory": "packages/check"
  },
  "homepage": "https://github.com/Sweeyya/toros#readme",
  "bugs": {
    "url": "https://github.com/Sweeyya/toros/issues"
  }
}
