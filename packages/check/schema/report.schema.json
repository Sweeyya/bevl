{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoodleyReport",
  "type": "object",
  "required": ["runId", "tool", "project", "seed", "score", "passed", "groups", "findings"],
  "properties": {
    "runId": { "type": "string" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "project": { "type": "string" },
    "seed": { "type": "number" },
    "renderer": {
      "type": "object",
      "properties": {
        "desktop": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "passed": { "type": "boolean" },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "weight"],
        "properties": {
          "score": { "type": "number" },
          "weight": { "type": "number" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "severity", "viewport", "message", "fix"],
        "properties": {
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warn", "info"] },
          "viewport": { "type": "string" },
          "section": { "type": "string" },
          "message": { "type": "string" },
          "fix": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "timings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "viewport", "ms"],
        "properties": {
          "rule": { "type": "string" },
          "viewport": { "type": "string" },
          "ms": { "type": "number" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
