{
  "name": "@toros/cli",
  "version": "0.1.0",
  "description": "Command line tool: toros create, add-section, apply-brand, optimize, check.",
  "type": "module",
  "bin": {
    "toros": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@toros/check": "workspace:*",
    "@toros/optimizer": "workspace:*",
    "@toros/tokens": "workspace:*",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
