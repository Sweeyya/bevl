{
  "name": "@toros/core",
  "version": "0.1.0",
  "description": "3D runtime: sections, scroll camera path, design rules, test mode and test bridge",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
