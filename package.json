{
  "name": "doodley-root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:fixtures": "turbo run test:fixtures",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "turbo run test:visual",
    "test:perf": "turbo run test:perf",
    "test:determinism": "turbo run test:determinism",
    "check:examples": "turbo run check:examples",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "verify": "biome ci . && turbo run typecheck test",
    "verify:full": "pnpm verify && turbo run test:fixtures test:e2e check:examples",
    "hooks": "git config core.hooksPath .githooks",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "golden": "turbo run golden",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "pkg:lint": "publint --strict packages/*/",
    "pkg:types": "attw --profile esm-only --pack packages/core && attw --profile esm-only --pack packages/check && attw --profile esm-only --pack packages/cli && attw --profile esm-only --pack packages/mcp",
    "pkg:size": "size-limit",
    "pkg:unused": "knip",
    "pkg:pack-check": "pnpm pack --dry-run --filter @doodley/core --filter @doodley/check --filter @doodley/cli --filter @doodley/mcp"
  },
  "size-limit": [
    {
      "path": "packages/core/dist/index.js",
      "limit": "400 kB",
      "name": "@doodley/core (gzip)",
      "ignore": [
        "react",
        "react-dom",
        "three",
        "@react-three/fiber",
        "@react-three/drei"
      ]
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.3.0",
    "knip": "6.45.1",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  }
}
